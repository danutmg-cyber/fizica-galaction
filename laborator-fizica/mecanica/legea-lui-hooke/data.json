  "description": "Laborator pe șapte pagini pentru studiul deformării elastice a unui resort, măsurarea alungirii și determinarea constantei elastice k.",
  "learningObjectives": [
    "să definească alungirea elastică",
    "să aplice relația Δl = l - l0",
    "să recunoască proporționalitatea dintre forță și alungire",
    "să aplice legea lui Hooke F = kΔl",
    "să determine constanta elastică k",
    "să transforme lungimile din centimetri în metri",
    "să traseze și să interpreteze graficul F(Δl)",
    "să identifice limita elastică și surse de eroare"
  ],
  "theory": {
    "gravityAcceleration": {
      "value": 10,
      "unit": "N/kg"
    },
    "formulas": [
      {
        "id": "extension",
        "latex": "\\Delta l=l-l_0"
      },
      {
        "id": "hooke-law",
        "latex": "F_e=k\\Delta l"
      },
      {
        "id": "weight",
        "latex": "F=G=mg"
      },
      {
        "id": "spring-constant",
        "latex": "k=\\frac{F}{\\Delta l}"
      }
    ],
    "units": {
      "force": "N",
      "extension": "m",
      "springConstant": "N/m"
    }
  },
  "materials": [
    "resort elastic",
    "stativ cu cârlig",
    "set de mase marcate",
    "riglă milimetrică",
    "tabel pentru măsurători"
  ],
  "safety": [
    "se folosesc mase mici și se adaugă treptat",
    "nu se depășește limita elastică",
    "stativul trebuie fixat",
    "masele nu trebuie lăsate să cadă",
    "măsurarea se face după oprirea oscilațiilor"
  ],
