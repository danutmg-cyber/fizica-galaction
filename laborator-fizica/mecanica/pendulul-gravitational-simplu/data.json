  "description": "Laborator pe șapte pagini pentru măsurarea perioadei unui pendul gravitațional simplu și determinarea accelerației gravitaționale g.",
  "learningObjectives": [
    "să definească perioada de oscilație",
    "să măsoare lungimea pendulului până la centrul corpului",
    "să cronometreze mai multe oscilații",
    "să calculeze perioada T = tN/N",
    "să determine accelerația gravitațională",
    "să traseze graficul T²(l)",
    "să explice de ce amplitudinea trebuie să fie mică",
    "să identifice surse de eroare experimentală"
  ],
  "theory": {
    "smallAngleCondition": "unghi inițial aproximativ mai mic de 10°",
    "formulas": [
      {
        "id": "period-from-time",
        "latex": "T=\\frac{t_N}{N}"
      },
      {
        "id": "pendulum-period",
        "latex": "T=2\\pi\\sqrt{\\frac{l}{g}}"
      },
      {
        "id": "gravity",
        "latex": "g=\\frac{4\\pi^2l}{T^2}"
      },
      {
        "id": "linearized",
        "latex": "T^2=\\frac{4\\pi^2}{g}l"
      }
    ],
    "units": {
      "length": "m",
      "time": "s",
      "period": "s",
      "gravity": "m/s²"
    }
  },
  "materials": [
    "fir subțire și rezistent",
    "corp mic și greu",
    "suport stabil",
    "riglă sau ruletă",
    "cronometru"
  ],
  "safety": [
    "pendulul se fixează pe un suport stabil",
    "corpul nu se ridică la un unghi mare",
    "zona de oscilație trebuie să fie liberă",
    "pendulul se eliberează fără împingere",
    "măsurarea se face fără a atinge pendulul"
